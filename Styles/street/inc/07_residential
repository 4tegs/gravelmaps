# Residential
# Geprüft am 22.07.2020
# Reworked am 11.09.2021
# ............................................................
#
# .....................
#  Paved first 
# .....................
# Paved kein Tunnel
(highway=residential) & EnduroOffroad!=yes	& tunnel!=yes			[0x06 road_class=0 road_speed=2 resolution 24 continue] # 8 bit
(highway=residential) & EnduroOffroad!=yes	& tunnel!=yes			[0x1000B resolution 23-23 continue] # 6 Bit
(highway=residential) & EnduroOffroad!=yes	& tunnel!=yes			[0x1000C resolution 22-22 continue] # 4 Bit
# Paved Tunnel	
(highway=residential) & EnduroOffroad!=yes	& tunnel=yes			[0x14 road_class=0 road_speed=2 resolution 24 continue] # 8 bit
(highway=residential) & EnduroOffroad!=yes	& tunnel=yes			[0x10503 resolution 23-23 continue] # 6 Bit
(highway=residential) & EnduroOffroad!=yes	& tunnel=yes			[0x1000C resolution 22-22 continue] # 4 Bit
	
# .....................	
#  Unpaved	
# .....................	
# Unpaved kein Tunnel	
(highway=residential) & EnduroOffroad=yes	& tunnel!=yes			[0x12 road_class=0 road_speed=2 resolution 24 continue] # 8 bit
(highway=residential) & EnduroOffroad=yes	& tunnel!=yes			[0x1010D resolution 23-23 continue]  # 6 Bit green colored
(highway=residential) & EnduroOffroad=yes	& tunnel!=yes			[0x1010E resolution 22-22 continue]  # 4 Bit
# Unpaved Tunnel	
(highway=residential) & EnduroOffroad=yes	& tunnel=yes			[0x14 road_class=0 road_speed=2 resolution 24 continue] # 8 bit
(highway=residential) & EnduroOffroad=yes	& tunnel=yes			[0x10503 resolution 23-23 continue] # 6 Bit
(highway=residential) & EnduroOffroad=yes	& tunnel=yes			[0x1010E resolution 22-22 continue]  # 4 Bit
	
# .....................	
#  Bridges	
# .....................	
(highway=residential) & bridge=yes 									[0x10102 resolution 24 continue] 	# 12 bit (je 1 Rand ; je 1 Abstand = 8 Innenraum)
(highway=residential) & bridge=yes 									[0x10103 resolution 23-23 continue] # 10 bit (je 1 Rand ; je 1 Abstand = 6 Innenraum)
	
# .....................	
#  Fords	
# .....................	
(highway=residential) & ford=*           			    			[0x10402 resolution 24 continue] # 14 bit (2 davon Rand pro Seite)
(highway=residential) & ford=*           			    			[0x10403 resolution 23-23 continue] # 14 bit (2 davon Rand pro Seite)
	
	
# .....................	
# access=private	
# .....................	
(highway=residential) & access=private								[0x1001E resolution 24-23 continue]

