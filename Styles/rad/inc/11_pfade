# .....................
# Path
# .....................
# !!! Hier ist eine wichtige Änderung die bei einer Straßenkarte nicht sein darf: 
# !!  add access = yes; Muss bei Straße no sein. !!
#	2019 12 13 - 	Nehme nur den access=no oder yes raus und belasse das routing somit exact so wie es in OSM 
#					eingegeben war. Das Ziel muss sein, daß du ggf nur mit Rad-Routing durchkommst!
# highway=path 	{add access = yes; add bicycle = yes; add foot = yes}		[0x08 road_class=0 road_speed=1 resolution 24 continue] # Enduro
# 
highway=path 																{add bicycle = yes; add foot = yes}							
																			[0x08 road_class=0 road_speed=1 resolution 24 continue] # Enduro
highway=path  & (network=lwn|network=rwn) 									{name '${PR}'} [0x10e02 resolution 22 continue]
highway=path  & (network=nwn|network=iwn) 									{name '${GR}'} [0x10e01 resolution 22 continue]
highway=path & route_refbike=yes 											{name '${bikeref|highway-symbol:oval}'} 
																			[0x10e03 resolution 24-22 continue] 
highway=path & tunnel=yes  													[0x10504 resolution 24 continue]
highway=path & bridge=yes  													[0x10104 resolution 24]

# .....................
# footways
# .....................
highway=footway 															{add access = no; add foot = yes; add bicycle = yes;}		
																			[0x09 road_class=0 road_speed=0 resolution 24 continue]
highway=footway  & (network=lwn|network=rwn) 								{name '${PR}'} [0x10e02 resolution 22 continue]
highway=footway  & (network=nwn|network=iwn) 								{name '${GR}'} [0x10e01 resolution 22 continue]
highway=footway & route_refbike=yes 										{name '${bikeref|highway-symbol:oval}'} 
																			[0x10e03 resolution 22 continue] 
highway=footway & tunnel=yes 												[0x10504 resolution 24 continue]
highway=footway & bridge=yes 												[0x10104 resolution 24]

# .....................
# pedestrian streets
# avoids creating pedestrian lines around pedestrian squares and things like piers
# .....................
highway=pedestrian & area!=yes & man_made!=yes 								{add access = no; add foot = yes; add bicycle = yes;} 
																			[0x0a road_class=0 road_speed=0 resolution 24 continue]																	
highway=pedestrian  & (network=lwn|network=rwn) 							{name '${PR}'} [0x10e02 resolution 22 continue]
highway=pedestrian  & (network=nwn|network=iwn) 							{name '${GR}'} [0x10e01 resolution 22 continue]
highway=pedestrian & route_refbike=yes 										{name '${bikeref|highway-symbol:oval}'} 
																			[0x10e03 resolution 22 continue] 
highway=pedestrian & area!=yes & man_made!=yes & tunnel=yes					[0x10504 resolution 24 continue]
highway=pedestrian & area!=yes & man_made!=yes & bridge=yes					[0x10104 resolution 24]

# .....................
# steps
# .....................
highway=steps 																{add access = no; add foot = yes; add bicycle = yes;} 	
																			[0x0b road_class=0 road_speed=0 resolution 24 continue]
highway=steps  & (network=lwn|network=rwn) 									{name '${PR}'} [0x10e02 resolution 22 continue]
highway=steps  & (network=nwn|network=iwn) 									{name '${GR}'} [0x10e01 resolution 22 continue]
highway=steps & route_refbike=yes 											{name '${bikeref|highway-symbol:oval}'} 
																			[0x10e03 resolution 22 continue]
highway=steps & tunnel=yes						 							[0x10504 resolution 24 continue]
highway=steps & bridge=yes 													[0x10104 resolution 24]

# .....................
# cycleway / byway
# .....................
(highway=cycleway | highway=byway ) 										{set access = yes; set bicycle = yes; set foot = yes}	
																			[0x0e road_class=0 road_speed=3 resolution 24-23 continue]
(highway=cycleway | highway=byway)  & (network=lwn|network=rwn) 			{name '${PR}'} [0x10e02 resolution 22 continue]
(highway=cycleway | highway=byway)  & (network=nwn|network=iwn) 			{name '${GR}'} [0x10e01 resolution 22 continue]
(highway=cycleway | highway=byway) 	& route_refbike=yes						{name '${bikeref|highway-symbol:oval}'} 
																			[0x10e03 resolution 22 continue]
(highway=cycleway | highway=byway) & tunnel=yes 							[0x10504 resolution 24-23 continue]
(highway=cycleway | highway=byway) & bridge=yes 							[0x10104 resolution 24-23]																			
