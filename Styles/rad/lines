# ---------------------------------------
# Zweck   : mkgmap-Regeln fuer Linien
# 2021 09 20 - Reworked for Greece
#
# Hinweis auf weitere Unterlagen:
# - http://wiki.openstreetmap.org/wiki/DE:Map_Features
# - http://wiki.openstreetmap.org/wiki/Mkgmap/How_to_create_a_map
# - http://wiki.openstreetmap.org/wiki/Mkgmap/help/style_rules
#
# Liste der Garmin-Standardbelegung (gemaess cGPSmapper-Manual; zur Orientierung):
#
# Routable types are: 0x01-0x13, 0x16, 0x1a, 0x1b
# 0x14 und 0x15 scheinen zu funktionieren
# 0x16 macht Mucken beim compile. Sagt man verwendete eine Routable Line für ein Non Routable Element
# 0x17 ist nicht Darstellbar!
# 
# !!!!!!!!!!! ACHTUNG
# Überlagerungen: Diese dürfen keine Bitmaps sein ??? Nochmals Prüfen
# note that many devices display type 0x14 only at resolution 24 
#
# Liste der verwendeten, routingfaehigen Strassen:
# http://h5864b.synology.me/drive/oo/r/516874424322924577
#
# Anmerkungen:
# - Transparente Bitmap-Linien sollten immer eine gerade Pixelbreite (2, 4, ..) haben.
#   Ist dies nicht der Fall, wird unter OS X eine schwarze Artefaktlinie dargestellt.
# - Linien mit nur einem Pixel Breite, sind auf einem GPSr kaum / schwer erkennbar.
# - Sind Linien in unterschiedlichen Leveln verschieden breit definiert, so sollte
#   der Linientyp (mit / ohne Rand) nicht gemischt werden. Dies fuehrt auf dem
#   GPS-Geraet zu einer inkorrekter Darstellung.
#
# Routing:
# -------
# Class  Used as
# 4  Major HW/Ramp
# 3  Principal HW
# 2  Arterial St / Other HW
# 1  Roundabout / Collector
# 0  Residential Street / Unpaved road / Trail
#
# road_speed  highest speed
# 7  No speed limit
# 6  70 mph / 110 kmh
# 5  60 mph /  90 kmh
# 4  50 mph /  80 kmh
# 3  35 mph /  60 kmh
# 2  25 mph /  40 kmh
# 1  15 mph /  20 kmh
# 0   3 mph /   5 kmh
#
# Zugangsbeschraenkungen:
# Fuer jeden Transporttyp kann die Art des erlaubten Verkehrs beschrieben werden (access):
# - yes          : Oeffentliche Wege und Strassen, die jeder benutzen darf.
# - private      : Der Eigentuemer kann die Erlaubnis zur Benutzung auf individueller Basis vergeben,
#                  in der Regel besteht jedoch keine Erlaubnis.
# - permissive   : Der Eigentuemer gestattet die Benutzung durch die Oeffentlichkeit in der Regel.
# - destination  : Benutzung nur dann erlaubt, wenn sich das Ziel nur ueber diesen Weg erreichen laesst;
#                  haeufig gekennzeichnet durch ein Zusatzschild "Anlieger frei", "ausgenommen Anrainer",
#                  "kein oeffentlicher Durchgang" oder in der Schweiz: "Zubringerdienst gestattet" SSV Art. 17.
# - agricultural : Benutzung nur fuer "landwirtschaftlichen Verkehr" erlaubt.
# - forestry     : Benutzung nur fuer "forstwirtschaftlichen Verkehr" erlaubt.
# - delivery     : Benutzung nur zur Anlieferung von Waren zum Kunden, meist mit Zusatzschild "Lieferverkehr frei".
# - designated   : Fuer diesen Transporttyp vorgesehener Weg, meistens ausgeschildert.
# - official     : Fuer diesen Transporttyp gesetzlich gewidmeter Weg, mit Verkehrszeichen ausgeschildert oder
#                  per Verordnung gewidmet, impliziert in Deutschland eine Benutzungspflicht und ein Verbot fuer
#                  alle anderen Transporttypen.
# - unknown      : Zufahrtsbeschraenkungen sind unbekannt bzw. nicht geklaert.
# - no           : Benutzung nicht erlaubt oder nicht moeglich.
#
# Um nicht alle Verkehrsteilnehmer erklaeren zu muessen fuer die der Weg verboten ist, verbietet
# man den Zugang zunaechst fuer Alle und erlaubt ihn dann fuer die Ausnahmen. Beispiel:
# - highway = path
# - access = no
# - foot = yes
# - bicycle = yes
#
# Zeichenreihenfolge von Linien:
# Die Reihenfolge, mit der Linien gezeichnet werden, kann (leider) nicht beeinflusst werden und ist somit zufaellig.
# Das heisst bei uebereinander liegenden oder sich kreuzenden Linien kann nicht bestimmt werden, welche Linien unten
# und welche Linie oben liegt. Dies fuehrt mitunter zu ungewollten Effekten. Beispiel: Einige Flussbruecken weisen
# "Luecken" auf. Diese entstehen, weil der Fluss ueber und nicht unter der Bruecke verlaeuft. Das Routing wird hierdurch
# aber nicht beeinflusst.
#
# Kraftfahrzeugfahrer sollten vermeiden : Mautstrassen, Fahrgemeinschaftsspuren, unbefestigte Strassen
# (Normal-) Radfahrer sollten vermeiden : Mautstrassen, unbefestigte Strassen
#
# Sonder-Routing: Wird nicht beachtet (weil für Routing verwendet) !
# - Mautpflichtige Strassen : {add toll = yes}
# - Fahrgemeinschaftsspuren : {add mkgmap:carpool=1}
# - Faehrverbindungen       : {add mkgmap:ferry=1}
#
# Konzeptionelle Anmerkungen zum Thema Routing:
# - Fuer das Routing wird ein eigenes "Netzwerk" definiert, insgesamt gibt es somit fuenf "Netzwerke":
#   - Routing
#   - Zoom-Level 1
#   - Zoom-Level 2
#   - Zoom-Level 3
#   - Zoom-Level 4
# - Folgende Transporttypen koennen unterschieden werden:
#   - Auto
#   - Zu Fuss
#   - Fahrrad
#   - Luftlinie
# - Das Routing erfolgt anhand der fuer das Objekt (highway, steps, ...) definierten access-Vorgaben (yes/no):
#   - motorcar
#   - bicycle
#   - foot
#
# Konzeptionelle Anmerkungen zum Thema Namen (von Strassen und Wegen):
# - Resolution 24: Anzeige aller Namen.
# - Resolution 23: Anzeige der Namen von Autobahnen und autobahnaehnlichen Bundesstrassen; kleiner Schrifttyp
# - für einige Linien werden keine Namen angezeigt; der Grund hierfuer ist unklar
# - die Ausgabeprioritaet von Namen ist unbekannt; ggf. haben die Namen "wichtiger" Strassen Vorrang
# - Strassen und Wege fuer die (nur) ein Pseudorouting definiert ist (hierdurch sind die Namen suchbar)
#   werden keine Namen ausgegeben
# - Vorgehensmodell: Ausgabe der Namen ueber die transparenten, routingfaehigen Linien
# - Ausnahmen: s.o. Resolution 23
#

# ------------------------------------------------------------------
# Manche Definitionen müssen bereits am Anfang gemacht werden
# ------------------------------------------------------------------
addr:housenumber=* {set mkgmap:execute_finalize_rules=true}
highway=* & name=* {set mkgmap:street='${name}' }								# Assign the street name for house number search

# ------------------------------------------------------------------
# Flugfelder, Maut
# ------------------------------------------------------------------
highway=* & (toll=yes|toll=true) { set mkgmap:toll=yes } 						# Mark highways with the toll flag
(aeroway=runway & 						highway!=* & is_closed()=false) 	{name '${ref}'} [0x27 resolution 24-22]
(aeroway=taxiway | aeroway=taxilane) & 	highway!=* & is_closed()=false 		{name '${ref}'} [0x27 resolution 24]

# ------------------------------------------------------------------
# 14.3.2018
# forbidden for motorvehicle, motorcycle, motorcar (motorrad-strecken-voll-sperrungen ausschliessen)
# (da garmin zumo550 nicht zwischen auto/motorcar und motorrad/motorcycle unterscheidet, auch motorcar=no!)
# >>>>>>>>>>>>>>>>>> Reines Enduro / Motorradsetting - route mit Auto oder Moped gleichermassen!  14.1.2019
motorcycle=no 							{ set motorcar='no'; set moped='no'; } 
(motorcycle=yes | moped=yes)  			{ set motorcar='yes'} 
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Aufgegeben, nicht gebaut, nicht zu routen
# ------------------------------------------------------------------
highway=* & mkgmap:mp_created=true 		{add area=yes}							# mark multipolygons as area
(highway=proposed | highway=proposal | highway=planned | highway ~ '.*proposed.*') 
										{delete highway;delete junction}  		# Hide proposed ways
(highway=razed | highway=dismantled) 	{deletealltags}							# Hide removed ways

# Hide abandoned ways. Abandoned highways have some evidence of their former existence but are no longer used. These
# abandoned highways could be useful in topographical maps.
# https://wiki.openstreetmap.org/wiki/Key:abandoned:
((abandoned:highway=* & highway!=*) | highway=abandoned) {deletealltags}

# Hide other non-existent ways
(highway=unbuilt | highway=neverbuilt | highway=rejected | highway ~ 'x-.*') 
										{delete highway;delete junction}

# Remove highway tag from ways which are not suitable for routing
highway=traffic_signals | highway=junction | highway=island | highway=centre_line | highway=traffic_island | highway=stopline 
										{delete highway} 
highway=piste | highway=ski 			{delete highway}
highway=no | highway=none 				{delete highway}

# Hide unaccessible tunnels
highway=* & tunnel=yes & (access=private|access=no)
	& foot!=* & bicycle!=* 				{delete highway;delete junction}

# Disable dead-end-checks for unaccessible oneways
highway=* & oneway=yes & (access=private|access=no)
										{add mkgmap:dead-end-check=false}

# Validation-like checks (uncomment to enable)
highway=motorway|highway=motorway_link 	{ add oneway=yes; add mkgmap:numbers=false }

# if the cycleway uses a former railway, then delete the railway first, as this may lead into viewing an abandoned railway instead of a cycleway.
(highway=cycleway | highway=byway) & 
(railway=abandoned | railway=proposed | railway=construction | railway=disused | abandoned:railway=* | demolished:railway=* | removed:railway=* | razed:railway=* | was:railway=* | historic:railway=*)	
										{delete railway; delete abandoned; delete demolished; delete removed; delete razed; delete was; delete historic;}

# ------------------------------------------------------------------
# start of rules for process-exits and process-destination options
# which may add info to a part of these highway=*_link roads:
# motorway_link, trunk_link, primary_link, secondary_link, tertiary_link
# ------------------------------------------------------------------
# build destination hint 
mkgmap:dest_hint=*
  { set dest_hint = '${destination:ref|subst: =>} ${mkgmap:dest_hint|subst:;=> |subst:/=> }' |
         '${ref|subst: =>} ${mkgmap:dest_hint|subst:;=> |subst:/=> }' | 
         '${mkgmap:dest_hint|subst:;=> |subst:/=> }';
       }

# build exit hint 
mkgmap:exit_hint=true 
  { set exit_hint = 'Exit ${mkgmap:exit_hint_ref} ${mkgmap:exit_hint_name}' | 
         'Exit ${mkgmap:exit_hint_ref} ${mkgmap:exit_hint_exit_to}' | 
         'Exit ${mkgmap:exit_hint_exit_to}' |
         'Exit ${mkgmap:exit_hint_name}' |
         'Exit ${mkgmap:exit_hint_ref}';
       }
  
# use destination hint and/or exit hint to build name              
(mkgmap:exit_hint=true | mkgmap:dest_hint=*)
  {	name '${exit_hint} ${dest_hint}' | 	'${dest_hint}' | 		'${exit_hint}' }
# end of rules for process-exits and process-destination options

highway=* {set EnduroOffroad=no}



# ------------------------------------------------------------------
# Lösche die Tracks mit sehr schlechtem Untergrund
# ------------------------------------------------------------------
highway=track & tracktype=grade5  {delete highway}

highway = track & tracktype ~ 'grade[4-5]' &
  (surface = dirt     | 
   surface = ground   | 
   surface = earth    | 
   surface = grass    | 
   surface = mud      |  
   surface = sand     |
   smoothness ~ 'very_bad|horrible|very_horrible|impassable' |
   sac_scale = * |  sport = via_ferrata |  highway = via_ferrata   )
{ delete highway }

# ------------------------------------------------------------------
# Flag paved  roads
# ------------------------------------------------------------------
highway=* & 
	(surface=asphalt | surface=paved | surface=sett | surface=chipseal |										   
    surface=concrete | surface=concrete:lanes | surface=concrete:plates | 
    surface=paving_stones  | surface=cobblestone  | 
   	surface=cobblestone:flattened  | surface=metal  | surface=wood | surface=unhewn_cobblestone)
{ set mkgmap:unpaved=0 ; set EnduroOffroad=no; }

# ------------------------------------------------------------------
# Versuch die guten Schotterwege die zu Straßen werden könnten abzufangen. (Style Street only)
# ------------------------------------------------------------------
# highway = * & tracktype ~ 'grade[1]'  & (motor_vehicle="yes" | motorcar="yes" | motorcycle="yes" | access="yes")  { set mkgmap:unpaved=0 ; set EnduroOffroad=yes; }
# highway = * & tracktype ~ 'grade[2]'  & (motor_vehicle="yes" | motorcar="yes" | motorcycle="yes" | access="yes")  { set mkgmap:unpaved=0 ; set EnduroOffroad=yes; }
# highway = * & tracktype ~ 'grade[3]'  & (motor_vehicle="yes" | motorcar="yes" | motorcycle="yes" | access="yes")  { set mkgmap:unpaved=0 ; set EnduroOffroad=yes; }

#(highway="primary" | highway="secondary" | highway="tertiary" | highway="unclassified" | highway="minor" | highway="road") & (surface="ground" | surface="unpaved")           
#																													{ set mkgmap:unpaved=0 ; set EnduroOffroad=yes; }
# ------------------------------------------------------------------
# Flag unpaved roads.
# Change am 28.01.2023: smoothness ~ 'bad| herausgenommen, denn in Bulgarien sind einige wesentlichen Strassen so gekennzeichnet = #7 bei Elchowo
# ------------------------------------------------------------------


highway=* & mkgmap:unpaved!=0 & (  
    surface=* |
	mtb:scale=* | 
    tracktype ~ 'grade[2-5]')
{ add mkgmap:unpaved=1 }

highway=* & EnduroOffroad!=no & sac_scale = * { add mkgmap:unpaved=1 } # 2025 07 06: necessary as some people are over-tagging roads with hiking scales. See Bussoleno City Center


highway = *
& (surface = ground  | surface = compacted   | surface = dirt |
   surface = earth   | surface = grass       | surface = grass_paver |
   surface = gravel  | surface = fine_gravel | surface = mud |
   surface = wood    | surface = pebblestone | surface = sand |
   surface = unpaved |
   tracktype ~ 'grade[2-5]' |
   smoothness ~ 'very_bad|horrible|very_horrible|impassable' |
   sport = via_ferrata |
   highway = via_ferrata   
   )
{ add mkgmap:road-speed = '-2' ; set mkgmap:unpaved=1 }

(highway = bridleway | highway = path | highway = track)
& surface != * & tracktype != * & smoothness != * & sac_scale != *
{ add mkgmap:unpaved=1 }

# ------------------------------------------------------------------
# Flag unklare Highway mit Grade1
# 	In Griechenland wird für die normalen Schotterverbindungsstrecken 
# 	Track / Grade1 genutzt. Dito Balkanländer.
# 	In Deutschland / CH / F ist das wiederum sehr wahrschein ein geteerter Weg
# 	Setzte die Länder in ihrer Reihenfolge wie du sie behandelt haben willst
# ------------------------------------------------------------------

highway=* & tracktype=grade1 & mkgmap:unpaved!=* & (mkgmap:admin_level2 ~ 'GRC|TUR|MKD|HRV|SVN|SVK|SRB|ROU|HUN|BGR|BIH|MNE|ALB|XKX')
																				{set mkgmap:unpaved=1;}

highway=* & tracktype=grade1 & mkgmap:unpaved!=* & (mkgmap:admin_level2 ~ 'DEU|CHE')
																				{set mkgmap:unpaved=0;}
# Am Ende räume auf, so daß keine unklaren Wege mehr vorhanden sind. 
highway=* & tracktype=grade1 & mkgmap:unpaved!=* 								{set mkgmap:unpaved=0;}

# ------------------------------------------------------------------
# Definiere die Endurotracks (Schlechte Feldwege)
# Lösche diese für die StrassenKarte
# ------------------------------------------------------------------
highway=* & ( 	(tracktype=grade4 | tracktype=grade5) &
				surface ~ 'dirt|earth|grass|grass_paver|ground|mud|sand|woodchips|salt|snow|ice' | 
				smoothness ~ 'very_horrible|impassable' 
			) 
 			{ set EnduroOffroad = yes }
# Lösche nun alle weiteren Gras / Feldwege raus die nicht geschottert sind
# ((highway=unsurfaced | highway=track | highway=path) & (tracktype ~ 'grade[3-5]') ) {set motorcar=yes} # Enduro / Street

# ------------------------------------------------------------------
# Good ways without relation
highway=* & mkgmap:fast_road!=* & (int_ref=* | network=e-road | network=AH | network=TAH | network=US:I | network=US:US) {add mkgmap:fast_road=yes}
# Not best for car routing
highway=* & (access=hov | hov=designated | oneway=reversible) {set mkgmap:road-class=-2; set mkgmap:road-speed=-2; delete mkgmap:fast_road}

# ------------------------------------------------------------------
# Convert generic path to most specific
highway = path
& ( surface = ground      | 
    surface = compacted   | 
    surface = dirt        |
    surface = earth       | 
    surface = grass       | 
    surface = mud         |
    surface = pebblestone | 
    surface = sand        |
    mtb:scale = *         |
    tracktype ~ 'grade[3-5]' |
    smoothness ~ 'very_bad|horrible|very_horrible|impassable' |
    sac_scale = * |
    sport = via_ferrata |
    highway = via_ferrata   
   ) 
#   &   (bicycle!=yes & bicycle!=designated & bicycle!=permissive & bicycle!=official)
{ delete highway }

highway=footway & (bicycle=yes|bicycle=designated|bicycle=permissive|bicycle=official) 	{set highway=cycleway; set bicycle=yes; set foot=yes}
highway=path    & (bicycle=yes|bicycle=designated|bicycle=permissive|bicycle=official) 	{set highway=cycleway; set bicycle=yes; set foot=yes}
highway=path    & (surface=asphalt|surface=paving_stones|tracktype ~ 'grade[1-2]') 			{set highway=cycleway; set bicycle=yes; set foot=yes}
highway=path & (horse=designated|horse=permissive|horse=official) {set highway=bridleway; set horse=yes}
#
leisure=track	{add access = no; add bicycle = no; add foot = no ; delete highway} 	[0x10313 resolution 24-23]
# leisure=track & area!=yes  {add highway=footway; name '${name} (${sport})' | '${name}'}
(man_made=pier | man_made=piste:halfpipe) & area!=yes {add highway=footway; name '${ref} ${name}' | '${ref}' | '${name}' }

# ------------------------------------------------------------------
# Ways that may or may not be useable

# Treat ways under construction almost as highway=path, see also extra rule in inc/access
highway=construction 								{ add mkgmap:dead-end-check = false; } [0x1C resolution 24-22]
# Lower the road speed of ways under some construction.
highway=* & construction=* & maxspeed!=* 			{ add mkgmap:road-speed = '-1' }
# Lower the road speed of disused ways.
highway=* & disused=yes & maxspeed!=* 				{ add mkgmap:road-speed = '-2' }

