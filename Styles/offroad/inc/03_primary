# .....................
#  Paved first 
# .....................
# Paved kein Tunnel
(highway=primary | highway=primary_link) & mkgmap:unpaved!=1 & tunnel!=yes			[0x03 road_class=3 road_speed=5 resolution 24 continue] # 10 bit
(highway=primary | highway=primary_link) & mkgmap:unpaved!=1 & tunnel!=yes			[0x10006 resolution 23-20 continue]						# 6
(highway=primary | highway=primary_link) & mkgmap:unpaved!=1 & tunnel!=yes			[0x10007 resolution 19-18 continue] 					# 2
# Paved Tunnel
(highway=primary | highway=primary_link) & mkgmap:unpaved!=1 & tunnel=yes			[0x13 road_class=3 road_speed=5 resolution 24 continue] # 10 bit
(highway=primary | highway=primary_link) & mkgmap:unpaved!=1 & tunnel=yes			[0x10503 resolution 23-20 continue] 					# 6
(highway=primary | highway=primary_link) & mkgmap:unpaved!=1 & tunnel=yes			[0x10504 resolution 19-18 continue]						# 4

# .....................
#  UnPaved
# .....................
# UnPaved kein Tunnel
(highway=primary | highway=primary_link) & mkgmap:unpaved=1 & tunnel!=yes			[0x12 road_class=3 road_speed=4 resolution 24 continue] # 4 bit
(highway=primary | highway=primary_link) & mkgmap:unpaved=1 & tunnel!=yes			[0x1010D resolution 23-22 continue]						# 4
(highway=primary | highway=primary_link) & mkgmap:unpaved=1 & tunnel!=yes			[0x10006 resolution 21-20 continue]						# 6
(highway=primary | highway=primary_link) & mkgmap:unpaved=1 & tunnel!=yes			[0x10007 resolution 21-18 continue]						# 4
# UnPaved Tunnel
(highway=primary | highway=primary_link) & mkgmap:unpaved=1 & tunnel=yes			[0x13 road_class=3 road_speed=4 resolution 24 continue] # 10 bit
(highway=primary | highway=primary_link) & mkgmap:unpaved=1 & tunnel=yes			[0x10503 resolution 23-20 continue]					  	# 6
(highway=primary | highway=primary_link) & mkgmap:unpaved=1 & tunnel=yes			[0x10504 resolution 19-18 continue]						# 4

#___________________________________________________________________________________________________________

#-- zoom bridges
(highway=primary | highway=primary_link) & bridge=yes 	[0x10100 resolution 24    continue]	# 16 bit (2 davon Rand pro Seite, 1 Abstand)
(highway=primary | highway=primary_link) & bridge=yes 	[0x10101 resolution 23-21 continue] # 12 bit (1 davon Rand pro Seite, 1 Abstand)

#-- zoom Furt
highway=primary & ford=*   	 	                		[0x10400  resolution 24    continue] # 16 bit (2 davon Rand pro Seite)
highway=primary & ford=*   	 	                		[0x10401  resolution 23    		   ] # 14 bit (2 davon Rand pro Seite)

# ....................................
# Regional & International hiking network
# ....................................
(highway=primary | highway=primary_link) & (network=lwn|network=rwn) {name '${PR}'} [0x10e02 resolution 22 continue]
(highway=primary | highway=primary_link) & (network=nwn|network=iwn) {name '${GR}'} [0x10e01 resolution 22 continue]
# .....................
#  Radwege
# .....................
(highway=primary | highway=primary_link) & route_refbike=yes {name '${bikeref|highway-symbol:oval}'} [0x10e03 resolution 24-22] 