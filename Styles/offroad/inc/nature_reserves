# .....................
# Finde die großen Naturschutzgebiete im Meer und lösche diese
# .....................
(boundary=protected_area | boundary=national_park | leisure=nature_reserve) & (maritime=yes | protect_class=6 | national_park=marine) {deletealltags}
(boundary=protected_area & name ="Sanctuaire Pelagos") {deletealltags}
(boundary=protected_area & (name ="Parc naturel marin du Cap Corse et de l'Agriate" | name ="Réserve naturelle des Bouches de Bonifacio" | protection_title="parc naturel marin")) {deletealltags}
(boundary=protected_area & (name ="Réserve naturelle des Bouches de Bonifacio" | protection_title="parc naturel marin")) {deletealltags}
((name ="Zona C - Area Marina Protetta Penisola Del Sinis - Isola Di Mal Di Ventre") | (name="Riserva Naturale Marina Isole Egadi")) {deletealltags}

# Southeast Map: Greece Alonissos Island: Sea Nature Protection area overlays the island for too long
(boundary=protected_area & protect_class=2 & (site_zone=A | site_zone=B)) {deletealltags}


