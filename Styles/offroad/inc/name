# 2) 
# set preferred German names as a second name in paranthesis. That's essential in border areas 
# (e.g. Alsace) or in countries where there are German speaking roots (e.g. Romania)
# ..............................................................
name=* & ( 	mkgmap:admin_level2=ROU |
			mkgmap:admin_level2=HUN |
			mkgmap:admin_level2=SVK | 
			mkgmap:admin_level2=CZE | 
			mkgmap:admin_level2=SVN | 
			mkgmap:admin_level2=FRA
			) &
	(place=* | water=* | natural=water | natural=bay | natural=glacier | natural=waterfall | natural=wetland | natural=sea | landuse=basin | landuse=reservoir)
	{set name=  '$(name) (${name:de|not-equal:name})' | 
				'${name}';}
